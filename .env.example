# ── Core ──
APP_ENV=production                 # development | staging | production
PORT=4000
DATABASE_URL=postgres://beatbox:beatbox@localhost:5432/beatbox
PUBLIC_URL=https://pos.example.com    # on Render this defaults to the service URL (RENDER_EXTERNAL_URL)
CORS_ORIGINS=                      # comma separated, empty = same origin
JWT_SECRET=change-me-long-random-string
PIN_PEPPER=change-me-another-long-random-string
SETTINGS_ENCRYPTION_KEY=           # encrypts API keys saved in Admin → การเชื่อมต่อ (default: derived from JWT_SECRET)
ADMIN_PIN=1234                     # first admin 4-digit code (seed only)
SEED_DEMO=true                     # create demo rooms/products/members on first start
SEED_DEMO_STAFF=true               # demo staff codes 2222/3333/4444 (set false on a public server)

# ── Payments / slip verification / LINE / SMS ──
# These can all be set in Admin → ตั้งค่าร้าน → การเชื่อมต่อ instead; values below are only fallbacks.
PAYMENT_MODE=DEMO                  # DEMO (simulated 5s slip check) | PRODUCTION (real provider / staff review)
SLIP_PROVIDER=manual               # slipok | easyslip | manual
SLIP_API_URL=
SLIP_API_KEY=
SLIP_BRANCH_ID=

# ── LINE Login / Messaging API ──
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_CALLBACK_URL=           # default: PUBLIC_URL/api/public/auth/line/callback
LINE_MESSAGING_ACCESS_TOKEN=

# ── SMS OTP ──
SMS_PROVIDER=                      # thsms | (empty = OTP only shown when OTP_DEBUG=true)
SMS_API_KEY=
SMS_SENDER=BEATBOX
OTP_DEBUG=false

# ── Storage ──
UPLOAD_DIR=/data/uploads           # legacy only — slips and imported fonts are now stored in the database
BACKUP_DIR=/data/backups
